# Copy file này thành application-dev.yml và điền thông tin database của bạn
# File application-dev.yml sẽ KHÔNG được push lên Git

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/quanlytaisanqr?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
    username: your_database_username
    password: your_database_password
    
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        
server:
  port: 8080
  
logging:
  level:
    com.tvu.quanlytaisan: DEBUG
    org.springframework.web: DEBUG
